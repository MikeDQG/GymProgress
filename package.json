{
  "name": "gymprogress",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "lint": "eslint frontend backend --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write \".prettierrc.json\" \"package.json\" \"{frontend,backend}/**/*.{ts,tsx,css,html,json}\" \"playwright.config.ts\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \".prettierrc.json\" \"package.json\" \"{frontend,backend}/**/*.{ts,tsx,css,html,json}\" \"playwright.config.ts\" \"e2e/**/*.ts\"",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
